PORT=4000

# Staff panel admin login. Change both before sharing the app.
ADMIN_EMAIL=admin@medbook.com
ADMIN_PASSWORD=change-this-password

# Signs login tokens. Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Database. Leave TURSO_* empty to use a local SQLite file (DATABASE_FILE).
DATABASE_FILE=data/medbook.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: comma-separated other websites allowed to call the API.
# Not needed when the API serves the websites itself (the default deployment).
# Leave empty to allow all.
CORS_ORIGINS=

# Only used by `npm run seed` (creates sample doctors that log in with this password).
SEED_DOCTOR_PASSWORD=
